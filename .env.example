EXPO_PUBLIC_SUPABASE_URL=https://dein-projekt.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=dein-anon-key

# Öffentliche URL des lokalen AI-Servers. Hier stehen niemals Provider-Keys.
EXPO_PUBLIC_AI_SERVER_URL=http://localhost:8787

# Ausschließlich serverseitig verwenden. Variablen ohne EXPO_PUBLIC_-Präfix
# werden nicht in den React-Native-/Web-Bundle übernommen.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:latest
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GOOGLE_GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

AI_SERVER_HOST=127.0.0.1
AI_SERVER_PORT=8787
AI_INTERNAL_TEST_MODE=false
AI_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8085
